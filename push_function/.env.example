# انسخي هذا الملف باسم .env محلياً فقط إن أردتِ تجربة الدالة على جهازك قبل
# النشر (اختياري تماماً) — لا تضعي القيم الحقيقية هنا في .env.example نفسه،
# ولا ترفعي ملف .env أبداً لأي مستودع Git (المسار مُستثنى أصلاً في .gitignore).
#
# القيمة الفعلية تُضبَط لاحقاً كمتغيّر بيئة (Environment Variable) داخل
# لوحة تحكم Vercel نفسها (Project Settings → Environment Variables)، وليس
# هنا — راجعي README.md في هذا المجلد للخطوات الكاملة.

FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","...":"..."}
